---
// La prochaine célébration (heure, jour, lieu). Le site est construit à l'avance :
// la page embarque les célébrations des prochains jours et le navigateur choisit celles qui ne sont pas passées.
import { prochaines, nomCourt, fmtHeure, type Celebration } from '../lib/agenda';
interface Props { lien?: string | null }
const { lien } = Astro.props;

const cs = await prochaines({ jours: 21, max: 60 });
const donnee = (c: Celebration) => ({
  d: c.debut.toISOString(), j: c.journee, h: fmtHeure(c), t: c.titre, l: nomCourt(c.lieu), n: c.lieu.nom, s: c.lieu.slug,
});
const jour = (c: Celebration) =>
  c.debut.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
const [p] = cs;
---
{p && (
  <section class="prochaine" data-celebrations={JSON.stringify(cs.map(donnee))}>
    <p class="prochaine-titre">Prochaine célébration</p>
    <a class="prochaine-principale" href={`/clochers/${p.lieu.slug}/`}>
      <span class="prochaine-heure">{fmtHeure(p)}</span>
      <span class="prochaine-detail">
        <span class="prochaine-jour">{jour(p)}</span>
        <strong class="prochaine-lieu">{p.titre} · {nomCourt(p.lieu)}</strong>
        <span class="prochaine-nom">{p.lieu.nom}</span>
      </span>
    </a>
    {lien && <a class="prochaine-toutes" href={lien}>Toutes les messes ›</a>}
  </section>
)}
<script>
  const TZ = 'Europe/Paris';
  const cle = (d: Date) => d.toLocaleDateString('fr-CA', { timeZone: TZ });
  const quand = (d: Date) => {
    const auj = new Date();
    const dem = new Date(auj.getTime() + 864e5);
    if (cle(d) === cle(auj)) return "aujourd'hui";
    if (cle(d) === cle(dem)) return 'demain';
    return d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: TZ });
  };

  for (const bloc of document.querySelectorAll<HTMLElement>('.prochaine')) {
    type C = { d: string; j: boolean; h: string; t: string; l: string; n: string; s: string };
    const maintenant = new Date();
    const debutJour = new Date(maintenant.toDateString());
    // une célébration reste affichée pendant son premier quart d'heure
    const avenir = (JSON.parse(bloc.dataset.celebrations!) as C[])
      .filter((c) => (c.j ? new Date(c.d) >= debutJour : new Date(c.d).getTime() > maintenant.getTime() - 15 * 6e4));
    if (!avenir.length) { bloc.hidden = true; continue; }
    const [p] = avenir;
    const a = bloc.querySelector<HTMLAnchorElement>('.prochaine-principale')!;
    a.href = `/clochers/${p.s}/`;
    a.querySelector('.prochaine-heure')!.textContent = p.h;
    a.querySelector('.prochaine-jour')!.textContent = quand(new Date(p.d));
    a.querySelector('.prochaine-lieu')!.textContent = `${p.t} · ${p.l}`;
    a.querySelector('.prochaine-nom')!.textContent = p.n;
  }
</script>
<style>
  .prochaine { background: var(--principale); color: #fff; border-radius: var(--rayon); padding: 14px 16px 12px; margin: 14px 0 8px; }
  .prochaine a { color: #fff; text-decoration: none; }
  .prochaine-titre { margin: 0 0 6px; font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; opacity: .85; }
  .prochaine-principale { display: flex; gap: 14px; align-items: center; }
  .prochaine-heure { font-size: 2.1rem; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .prochaine-detail { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .prochaine-jour { font-size: .9rem; }
  .prochaine-jour::first-letter { text-transform: uppercase; }
  .prochaine-lieu { font-size: 1.05rem; }
  .prochaine-nom { font-size: .8rem; opacity: .85; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .prochaine-toutes { display: inline-block; margin-top: 10px; font-weight: 700; font-size: .9rem; }
</style>
